# remote-server environment. Copy to .env and edit before `docker compose up`.
# Never commit a filled-in .env; every value below is a placeholder.

# ---- public identity -------------------------------------------------------
# Display name of this relay node (1-64 chars), shown in /.well-known/dsh-remote.
NODE_NAME=My Public Node
# Version string advertised by the node.
NODE_VERSION=0.6.0
# Optional comma-separated capability override: pairing,cache,official-ui,relay,turn
# Default: pairing,cache,official-ui,relay (+ turn when TURN_* is configured).
#CAPABILITIES=pairing,cache,official-ui,relay

# ---- HTTP ------------------------------------------------------------------
PORT=8787
BIND_HOST=0.0.0.0
# SQLite database directory (inside the container: /data).
DATA_DIR=/data
# Canonical HTTPS origin of the public node; cookies and WebSocket origins bind
# to it. Must match SITE_ADDRESS below.
PUBLIC_ORIGIN=https://relay.example.com
# Extra allowed browser origins (comma-separated), e.g. a custom pairing page.
#ALLOWED_ORIGINS=https://relay.example.com
# Trust X-Forwarded-Proto/Host/For. Only enable behind a reverse proxy you run.
TRUST_PROXY=1
LOG_LEVEL=info

# ---- Caddy (consumed by compose.yaml, not by the server) -------------------
# Public hostname that Caddy serves with automatic HTTPS.
SITE_ADDRESS=relay.example.com
# Let's Encrypt account email (optional but recommended).
ACME_EMAIL=admin@example.com

# ---- pairing / sessions ----------------------------------------------------
# One-time registration gate for POST /v1/hosts. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Leave empty only if you accept open Host registration.
HOST_REGISTRATION_TOKEN=replace-with-a-long-random-value
# Pairing ticket lifetime, 30-300 seconds.
PAIRING_TICKET_TTL_SECONDS=300
# Browser device cookie lifetime, 1-365 days.
SESSION_TTL_DAYS=30

# ---- static asset bridge ---------------------------------------------------
# Maximum size of one published asset, 1 KiB - 64 MiB.
ASSET_MAX_BYTES=16777216

# ---- TURN (optional; enables the "turn" capability) ------------------------
# Both TURN_URLS and TURN_SECRET are required together. Shared secret must be
# identical to coturn's --static-auth-secret.
#TURN_URLS=turn:relay.example.com:3478?transport=udp,turns:relay.example.com:5349?transport=tcp
#TURN_SECRET=replace-with-the-coturn-static-auth-secret
#TURN_TTL_SECONDS=3600
# coturn settings used by the optional `turn` compose profile.
#PUBLIC_IP=203.0.113.10
#TURN_REALM=dsh-remote

# ---- limits ----------------------------------------------------------------
#HELLO_TIMEOUT_MS=5000
#MAX_CONNECTIONS_PER_CLIENT=8
#MAX_CONNECTIONS=256
