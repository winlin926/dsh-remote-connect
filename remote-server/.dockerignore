# Build context is the repository root, because the server compiles the shared
# protocol from ../src/remote/vendor. This file documents what the image must not
# receive; keep it in sync with the files copied by the Dockerfile.
.git
.gitignore
node_modules
remote-server/node_modules
remote-server/dist
remote-server/data
remote-server/test
remote-server/*.log
remote-server/debug-repro.ts
tests
assets
agentworkrecords
screenshots.json
docs
*.md
!remote-server/README.md
