{
  "name": "@copylee/dsh-remote-control",
  "version": "0.2.9",
  "description": "DSH 扫码远程控制：独立移动界面、本机确认配对、固定公网域名与局域网直连",
  "type": "module",
  "license": "MIT",
  "author": "copylee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/copylee711/dsh-remote-control.git"
  },
  "homepage": "https://github.com/copylee711/dsh-remote-control#readme",
  "bugs": {
    "url": "https://github.com/copylee711/dsh-remote-control/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.css",
    "lib/*.txt",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "docs/*.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "remote-control",
    "qrcode",
    "frpc",
    "acme"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsdown",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "qa:host": "node scripts/launch-qa.mjs",
    "qa:desktop": "node scripts/launch-desktop-qa.mjs",
    "qa:browser": "node scripts/remote-qa.mjs",
    "qa:issue-1": "node scripts/issue-1-qa.mjs",
    "qa:sidebar": "node scripts/sidebar-footer-qa.mjs",
    "qa:sidebar-host": "node scripts/sidebar-entry-host-qa.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-web-frontend": "0.2.1-rc.3",
    "qrcode": "^1.5.4",
    "undici": "^7.30.0",
    "ws": "^8.18.3",
    "acme-client": "5.4.0",
    "https-proxy-agent": "^7.0.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-modules": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@playwright/test": "^1.56.0",
    "@shikijs/langs": "^4.5.0",
    "@tanstack/react-virtual": "3.13.12",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^22.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "^8.18.1",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "immer": "10.1.1",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "shiki": "^4.5.0",
    "simple-icons": "16.31.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "4.4.3",
    "zustand": "4.4.7"
  }
}
