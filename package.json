{
  "name": "@winlin926/dsh-remote-connect",
  "version": "0.3.0",
  "description": "远程连接",
  "type": "module",
  "license": "MIT",
  "author": "winlin926",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winlin926/dsh-remote-connect.git"
  },
  "homepage": "https://github.com/winlin926/dsh-remote-connect#readme",
  "bugs": {
    "url": "https://github.com/winlin926/dsh-remote-connect/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "remote-control",
    "qrcode",
    "frpc",
    "acme"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsdown",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "qa:host": "node scripts/launch-qa.mjs",
    "qa:desktop": "node scripts/launch-desktop-qa.mjs",
    "qa:browser": "node scripts/browser-qa.mjs",
    "qa:native": "node scripts/native-qa.mjs",
    "qa:sidebar": "node scripts/sidebar-footer-qa.mjs",
    "qa:sidebar-host": "node scripts/sidebar-entry-host-qa.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "undici": "^7.30.0",
    "ws": "^8.18.3",
    "acme-client": "5.4.0",
    "https-proxy-agent": "^7.0.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.5",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "^8.18.1",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
