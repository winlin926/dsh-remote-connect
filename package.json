{
  "name": "@winlin926/dsh-carry",
  "version": "0.6.1",
  "description": "DeepSeek Harness 远程控制：手机浏览器扫码接入电脑上的 DSH 会话，继续对话、审批工具、预览文件，局域网直连或自托管公网节点。",
  "type": "module",
  "license": "MIT",
  "author": "winlin926",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winlin926/dsh-carry.git"
  },
  "homepage": "https://github.com/winlin926/dsh-carry#readme",
  "bugs": {
    "url": "https://github.com/winlin926/dsh-carry/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote-control",
    "mobile",
    "phone",
    "pairing",
    "qrcode",
    "acme",
    "frpc"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc && tsdown",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "qa:host": "node scripts/launch-qa.mjs",
    "qa:browser": "node scripts/browser-qa.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "undici": "^7.30.0",
    "ws": "^8.18.3",
    "acme-client": "5.4.0",
    "https-proxy-agent": "^7.0.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.19.0 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~18.3.31",
    "@types/ws": "^8.18.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
